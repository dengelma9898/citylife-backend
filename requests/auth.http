# Prefer http-client.env.json (local / dev / prd) — see requests/env-check.http
@baseUrl = {{baseUrl}}
@firebaseApiKey = {{firebaseApiKey}}
@token = {{token}}

### Anonymous sign-up (same as Flutter anonymous auth)
# @name anonymousSignUp
POST https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={{firebaseApiKey}}
Content-Type: application/json

{
  "returnSecureToken": true
}

### Password sign-in (admin / test user)
# @name passwordSignIn
POST https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "your-password",
  "returnSecureToken": true
}

### Copy idToken from response into http-client.env.json -> token, then use env-check.http

